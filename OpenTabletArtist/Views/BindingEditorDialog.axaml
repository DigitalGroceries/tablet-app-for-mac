<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:OpenTabletArtist.Converters"
        x:Class="OpenTabletArtist.Views.BindingEditorDialog"
        Title="{Binding Title}"
        Width="880" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBaseBrush}">

    <Window.Resources>
        <!-- Keycap button: a light "physical key" fill so keys stand out from the card. A picked key
             gets an accent outline; an active modifier gets an accent-tinted fill (a distinct look). -->
        <!-- The keycap theme is shared with the hotkey-capture dialog: Themes/Keycaps.axaml (#617). -->

        <!-- One keycap: a fixed-width footprint (so rows of equal total units align regardless of key
             count) with the visible key inset by a small margin. Spacers render as empty footprint. -->
        <DataTemplate x:Key="KeyCapTemplate">
            <Border Width="{Binding Width}" Height="30">
                <Button Theme="{StaticResource KeyCapButton}" Classes.selected="{Binding IsSelected}"
                        Classes.modifier="{Binding IsModifier}"
                        Command="{Binding PickCommand}" CommandParameter="{Binding}"
                        Content="{Binding Display}" IsVisible="{Binding !IsSpacer}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1.5" />
            </Border>
        </DataTemplate>
        <!-- One keyboard row. -->
        <DataTemplate x:Key="KeyRowTemplate">
            <ItemsControl ItemsSource="{Binding}" Margin="0,0,0,3"
                          ItemTemplate="{StaticResource KeyCapTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="RadioButton.tab">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bd" Background="Transparent" Padding="16,9"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}"
                                   FontWeight="SemiBold" LetterSpacing="0.5"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tab:pointerover /template/ TextBlock#Lbl">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="RadioButton.tab:checked /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="RadioButton.tab:checked /template/ TextBlock#Lbl">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="{DynamicResource TypeCaptionSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="24">
        <!-- Heading -->
        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,14">
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource TypeTitleSize}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="Pick a type, set it, then Save. Clear removes the action."
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom">
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,0" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
                <Button Grid.Column="0" Content="Clear" Command="{Binding ClearCommand}"
                        Theme="{StaticResource GhostButton}" Padding="16,8"
                        ToolTip.Tip="Remove this action" />

                <!-- Combo preview: CTRL + ALT + E (keyboard tab only). -->
                <Grid Grid.Column="1" IsVisible="{Binding IsKeyboardTab}">
                    <TextBlock Text="No key selected" IsVisible="{Binding ComboEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontStyle="Italic" Foreground="{DynamicResource TextMutedBrush}" />
                    <ItemsControl ItemsSource="{Binding ComboParts}" IsVisible="{Binding !ComboEmpty}" HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ItemsPanel="{StaticResource ComboPartsPanel}"
                                  ItemTemplate="{StaticResource ComboPartTemplate}" />
                </Grid>

                <!-- Affirmative first/left, Windows convention (#502). -->
                <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}"
                        Theme="{StaticResource AccentButton}" Padding="22,8" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelDialogCommand}"
                        Theme="{StaticResource GhostButton}" Padding="16,8" />
            </Grid>
        </StackPanel>

        <!-- Tab strip -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Classes="tab" Content="Keyboard" GroupName="type"
                             IsChecked="{Binding IsKeyboardTab, Mode=TwoWay}" />
                <RadioButton Classes="tab" Content="Media" GroupName="type"
                             IsChecked="{Binding IsMediaTab, Mode=TwoWay}" />
                <RadioButton Classes="tab" Content="Mouse" GroupName="type"
                             IsChecked="{Binding IsMouseTab, Mode=TwoWay}" />
                <RadioButton Classes="tab" Content="Scroll" GroupName="type"
                             IsChecked="{Binding IsScrollTab, Mode=TwoWay}" />
                <RadioButton Classes="tab" Content="{Binding RadialTabLabel}" GroupName="type"
                             IsVisible="{Binding ShowRadialTab}"
                             IsChecked="{Binding IsRadialTab, Mode=TwoWay}" />
                <RadioButton Classes="tab" Content="{Binding TouchTabLabel}" GroupName="type"
                             IsVisible="{Binding ShowTouchTab}"
                             IsChecked="{Binding IsTouchTab, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <Panel Margin="0,16,0,0">
            <!-- Keyboard -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsKeyboardTab}">
                <StackPanel Spacing="14">
                    <!-- Three aligned sections: main block · nav cluster · numpad. -->
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ItemsControl ItemsSource="{Binding MainRows}" ItemTemplate="{StaticResource KeyRowTemplate}"
                                      VerticalAlignment="Top" />
                        <ItemsControl ItemsSource="{Binding NavRows}" ItemTemplate="{StaticResource KeyRowTemplate}"
                                      VerticalAlignment="Top" />
                        <ItemsControl ItemsSource="{Binding NumpadRows}" ItemTemplate="{StaticResource KeyRowTemplate}"
                                      VerticalAlignment="Top" />
                    </StackPanel>

                    <TextBlock Text="{Binding ModifierHint}"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <StackPanel Spacing="7">
                        <TextBlock Text="More keys" Classes="caption" />
                        <ItemsControl ItemsSource="{Binding MoreKeys}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Theme="{StaticResource KeyCapButton}"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding PickCommand}" CommandParameter="{Binding}"
                                            Content="{Binding Display}" Height="30" MinWidth="42"
                                            Margin="0,0,4,4" Padding="10,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Mouse -->
            <StackPanel Spacing="7" IsVisible="{Binding IsMouseTab}">
                <TextBlock Text="Button" Classes="caption" />
                <StackPanel Spacing="6">
                    <RadioButton Content="Left click" GroupName="mb"
                                 IsChecked="{Binding SelectedMouseButton, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Left}" />
                    <RadioButton Content="Right click" GroupName="mb"
                                 IsChecked="{Binding SelectedMouseButton, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Right}" />
                    <RadioButton Content="Middle click" GroupName="mb"
                                 IsChecked="{Binding SelectedMouseButton, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Middle}" />
                    <RadioButton Content="Back button" GroupName="mb"
                                 IsChecked="{Binding SelectedMouseButton, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Backward}" />
                    <RadioButton Content="Forward button" GroupName="mb"
                                 IsChecked="{Binding SelectedMouseButton, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Forward}" />
                    <RadioButton Content="Double Click" GroupName="mb"
                                 ToolTip.Tip="Posts a left-button double-click at the cursor (click count 1 then 2)."
                                 IsChecked="{Binding SelectedMouseButton, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=DoubleClick}" />
                </StackPanel>
            </StackPanel>

            <!-- Scroll -->
            <StackPanel Spacing="7" IsVisible="{Binding IsScrollTab}">
                <TextBlock Text="Direction" Classes="caption" />
                <StackPanel Spacing="6">
                    <RadioButton Content="Scroll up" GroupName="sc"
                                 IsChecked="{Binding SelectedScroll, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Up}" />
                    <RadioButton Content="Scroll down" GroupName="sc"
                                 IsChecked="{Binding SelectedScroll, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Down}" />
                    <RadioButton Content="Scroll left" GroupName="sc"
                                 IsChecked="{Binding SelectedScroll, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Left}" />
                    <RadioButton Content="Scroll right" GroupName="sc"
                                 IsChecked="{Binding SelectedScroll, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Right}" />
                    <RadioButton Content="{Binding PenScrollLabel}" GroupName="sc"
                                 ToolTip.Tip="{Binding PenScrollTip}"
                                 IsChecked="{Binding SelectedScroll, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Pen}" />
                    <RadioButton Content="{Binding PenZoomLabel}" GroupName="sc"
                                 ToolTip.Tip="{Binding PenZoomTip}"
                                 IsChecked="{Binding SelectedScroll, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Zoom}" />
                    <RadioButton Content="{Binding PenPanZoomLabel}" GroupName="sc"
                                 ToolTip.Tip="{Binding PenPanZoomTip}"
                                 IsChecked="{Binding SelectedScroll, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=PanZoom}" />
                </StackPanel>
                <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding ShowGestureSpeed}">
                    <TextBlock Text="{Binding SpeedLabel}" Classes="caption" />
                    <Grid ColumnDefinitions="Auto,*,Auto,52" ColumnSpacing="8">
                        <TextBlock Text="{Binding SpeedSlowLabel}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding GestureSpeed}" AutomationProperties.Name="Speed"
                                ToolTip.Tip="{Binding SpeedTip}" />
                        <TextBlock Grid.Column="2" Text="{Binding SpeedFastLabel}" VerticalAlignment="Center" />
                        <!-- V29 #140 (Zak): type the speed, 1 to 100. -->
                        <TextBox x:Name="GestureSpeedBox" Grid.Column="3" Width="52" MinWidth="0" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                                 FontWeight="SemiBold" MaxLength="6" Text="{Binding GestureSpeedInput, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Speed value" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Media (consumer keys — stored as keyboard bindings, no modifiers). -->
            <StackPanel Spacing="7" IsVisible="{Binding IsMediaTab}">
                <TextBlock Text="Media key" Classes="caption" />
                <StackPanel Spacing="6">
                    <RadioButton Content="Mute" GroupName="md"
                                 IsChecked="{Binding SelectedMediaKey, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Mute}" />
                    <RadioButton Content="Volume down" GroupName="md"
                                 IsChecked="{Binding SelectedMediaKey, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=VolumeDown}" />
                    <RadioButton Content="Volume up" GroupName="md"
                                 IsChecked="{Binding SelectedMediaKey, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=VolumeUp}" />
                    <RadioButton Content="Play / Pause" GroupName="md"
                                 IsChecked="{Binding SelectedMediaKey, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=PlayPause}" />
                    <RadioButton Content="Previous track" GroupName="md"
                                 IsChecked="{Binding SelectedMediaKey, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=PreviousSong}" />
                    <RadioButton Content="Next track" GroupName="md"
                                 IsChecked="{Binding SelectedMediaKey, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=NextSong}" />
                    <RadioButton Content="Stop" GroupName="md"
                                 IsChecked="{Binding SelectedMediaKey, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=StopSong}" />
                    <!-- V29 #87: the Mac's brightness keys (the built-in display and Apple displays; most other monitors ignore them). -->
                    <RadioButton x:Name="MediaBrightnessDown" Content="Brightness down" GroupName="md" IsVisible="{Binding ShowBrightnessKeys}"
                                 ToolTip.Tip="Like the Mac's brightness key: the built-in display and Apple displays. Most other monitors ignore it."
                                 IsChecked="{Binding SelectedMediaKey, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=BrightnessDown}" />
                    <RadioButton x:Name="MediaBrightnessUp" Content="Brightness up" GroupName="md" IsVisible="{Binding ShowBrightnessKeys}"
                                 ToolTip.Tip="Like the Mac's brightness key: the built-in display and Apple displays. Most other monitors ignore it."
                                 IsChecked="{Binding SelectedMediaKey, Mode=TwoWay, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=BrightnessUp}" />
                </StackPanel>
            </StackPanel>

            <!-- Radial menu (TASKS #42): the menu lives in this binding; the editor opens as its own sheet. -->
            <StackPanel Spacing="12" IsVisible="{Binding IsRadialTab}" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="{Binding RadialIntro}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding RadialSummary}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <Button Content="{Binding RadialEditLabel}" Command="{Binding EditRadialCommand}"
                        Theme="{StaticResource AccentButton}" Padding="16,8" HorizontalAlignment="Left" />
                <!-- V29 #143 (Zak's build 3 test: 'No floating keyboard menu'): the keyboard is one click away here. -->
                <StackPanel x:Name="KeyboardLine" Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding KeyboardLineLabel}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="KeyboardSlotBox" ItemsSource="{Binding KeyboardSlots}" SelectedIndex="{Binding KeyboardSlot, Mode=TwoWay}"
                                  MinWidth="200" AutomationProperties.Name="Slice for the keyboard" />
                        <Button x:Name="KeyboardPutButton" Content="{Binding KeyboardPutLabel}" Command="{Binding PutKeyboardCommand}" Padding="12,6" />
                    </StackPanel>
                    <TextBlock Text="{Binding KeyboardStatus}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               IsVisible="{Binding KeyboardStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>

            <!-- Touch on/off (V28 #77): only for tablets whose finger touch the app drives. -->
            <StackPanel Spacing="12" IsVisible="{Binding IsTouchTab}" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="{Binding TouchIntro}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Panel>
    </DockPanel>
</Window>
