<UserControl x:Class="OpenTabletArtist.Views.AboutView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls">

    <!-- DataContext is the AboutViewModel (typed-nav DataTemplate, #15). Folded into Home's left column,
         above YOUR TABLETS, so it stretches to fill whatever column hosts it. -->
    <!-- Build R5 (the user's mock-up): the six links are SMALL (26 px high, 11 pt, equal 116 px cells) and tucked
         into the top-right corner; the version line is right-aligned under them. -->
    <!-- Build R4: no "About" heading. Six button-like links in two rows of three, in theme colours
         (Fluent button brushes, driven by the lightness setting), then one small line with the version.
         Sits in Home's right column, top-right. -->
    <UserControl.Styles>
        <!-- Build R6: the global TextBlock size (13) beat the button's FontSize, so labels were cut off. -->
        <!-- V10: wrap long Bulgarian labels. V12: every Home link is one fixed size (same idea as Pen
             tip/Eraser cards) so short labels don't leave short tiles next to two-line ones. -->
        <Style Selector="Button.homeLink">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.homeLink TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="118" />
        </Style>
    </UserControl.Styles>
    <StackPanel x:Name="HomeLinks" Width="394" HorizontalAlignment="Right" VerticalAlignment="Top">
            <UniformGrid x:Name="LinkGrid" Columns="3" Rows="3" ColumnSpacing="8" RowSpacing="6">
                <Button x:Name="HelpLink" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding HelpUrl}" Classes="homeLink" ToolTip.Tip="{Binding HelpTip}"
                        HorizontalAlignment="Stretch" FontSize="11" Cursor="Hand">
                    <TextBlock Text="{Binding GetHelpLabel}" />
                </Button>
                <Button x:Name="SupportedTabletsLink" Command="{Binding OpenSupportedTabletsCommand}" Classes="homeLink" ToolTip.Tip="Show the tablets OpenTabletDriver supports"
                        HorizontalAlignment="Stretch" FontSize="11" Cursor="Hand">
                    <TextBlock Text="{Binding SupportedTabletsLabel}" />
                </Button>
                <Button x:Name="SourceLink" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding RepoUrl}" IsEnabled="{Binding HasRepoUrl}" Classes="homeLink" ToolTip.Tip="{Binding RepoUrl}"
                        HorizontalAlignment="Stretch" FontSize="11" Cursor="Hand">
                    <TextBlock Text="{Binding SourceCodeLabel}" />
                </Button>
                <Button x:Name="ReleasesLink" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ReleasesUrl}" IsEnabled="{Binding HasReleasesUrl}" Classes="homeLink" ToolTip.Tip="{Binding ReleasesUrl}"
                        HorizontalAlignment="Stretch" FontSize="11" Cursor="Hand">
                    <TextBlock Text="{Binding ReleasesLabel}" />
                </Button>
                <Button x:Name="FeedbackLink" Command="{Binding OpenReportCommand}" Classes="homeLink" ToolTip.Tip="{Binding ReportTip}"
                        HorizontalAlignment="Stretch" FontSize="11" Cursor="Hand">
                    <TextBlock Text="{Binding FeedbackLabel}" />
                </Button>
                <Button x:Name="ManualLink" Command="{Binding OpenHelpCommand}" Classes="homeLink" ToolTip.Tip="Open the user manual"
                        HorizontalAlignment="Stretch" FontSize="11" Cursor="Hand">
                    <TextBlock Text="{Binding UserManualLabel}" />
                </Button>
                <Button x:Name="CreditsButton"  Classes="homeLink" ToolTip.Tip="Credits, modified-version notice and licences"
                        HorizontalAlignment="Stretch" FontSize="11" Cursor="Hand">
                    <TextBlock Text="{Binding CreditsLabel}" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <TextBlock x:Name="CreditsText" MaxWidth="420" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding CreditsBlurb}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </UniformGrid>
            <!-- Version 14 (Zak): the "Feedback is read once a week." line under the links was removed. -->
            <!-- Version 7: updates. -->
            <StackPanel x:Name="UpdatesPanel" Spacing="8" Margin="0,10,0,0" HorizontalAlignment="Right">
                <!-- Version 23 (owner's report, 4 Nov 2026: "Go back to Ver…" was cut off at every window size): these
                     rows wrap, so a button that doesn't fit goes under, right-aligned, instead of being cut. -->
                <WrapPanel x:Name="UpdateNowRow" ItemSpacing="8" LineSpacing="8" ItemsAlignment="End" HorizontalAlignment="Right">
                    <Button x:Name="CheckForUpdatesButton" Content="{Binding CheckUpdatesLabel}" Command="{Binding CheckForUpdatesCommand}" />
                    <Button x:Name="UpdateNowButton" Content="{Binding UpdateNowLabel}" IsVisible="{Binding UpdateReady}" Command="{Binding UpdateNowCommand}" />
                </WrapPanel>
                <!-- Version 14: the choice between stable and BETA (not tested yet), and back to stable from a BETA.
                     Version 15: "Earlier versions…" is always there, so any version (stable or BETA) can go back. -->
                <WrapPanel x:Name="UpdateChoicesRow" ItemSpacing="8" LineSpacing="8" ItemsAlignment="End" HorizontalAlignment="Right">
                    <Button x:Name="EarlierVersionsButton" Content="{Binding EarlierLabel}" Command="{Binding ChooseEarlierCommand}" />
                    <Button x:Name="TryBetaButton" Content="{Binding TryBetaLabel}" IsVisible="{Binding BetaOfferReady}" Command="{Binding TryBetaCommand}" />
                    <Button x:Name="GoBackButton" Content="{Binding GoBackLabel}" ToolTip.Tip="{Binding GoBackTip}" IsVisible="{Binding GoBackReady}" Command="{Binding GoBackCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding UpdateStatus}" HorizontalAlignment="Right" TextWrapping="Wrap" />
                <CheckBox x:Name="UpdateAutomaticallyBox" Content="{Binding UpdateAutomaticallyLabel}" IsChecked="{Binding UpdateAutomatically}" HorizontalAlignment="Right" />
            </StackPanel>
            <TextBlock x:Name="AboutLine" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="10" TextAlignment="Right"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="{Binding AboutLineText}" />
    </StackPanel>
</UserControl>
