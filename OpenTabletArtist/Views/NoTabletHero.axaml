<UserControl x:Class="OpenTabletArtist.Views.NoTabletHero"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- The "no tablet yet" empty state shared by the Tablet + Pen pages (#580): a quiet Zune hero
         straight over the sakura backdrop (no card), so the drifting petals read behind the big light
         headline. Only the Description differs between the two pages.
         TASKS #76 (Version 28): with no tablet the app is still fully usable: "Choose your tablet" sets one up
         before it is plugged in (the button shows when the page's view model offers ChooseTabletCommand). -->
    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="12" Margin="4,24,0,0">
        <!-- Off the type ramp on purpose: a hero on an otherwise empty page, between the nav
             size and the display size, where neither reads right. Light and letterspaced to
             match the page-title look rather than a section heading. -->
        <TextBlock x:Name="HeroTitle" Text="No tablet yet" FontFamily="{DynamicResource DisplayFontFamily}"
                   FontSize="36" FontWeight="Light" LetterSpacing="-0.3"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock x:Name="HeroBody" Text="{Binding #Root.Description}"
                   TextWrapping="Wrap" MaxWidth="540"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <Button x:Name="ChooseButton" Content="Choose your tablet" HorizontalAlignment="Left" Margin="0,6,0,0"
                Theme="{StaticResource AccentButton}" Padding="16,8"
                Command="{Binding ChooseTabletCommand}"
                IsVisible="{Binding ChooseTabletCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
</UserControl>
