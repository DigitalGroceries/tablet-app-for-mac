<UserControl x:Class="OpenTabletArtist.Views.StartupView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls"
             xmlns:v="using:OpenTabletArtist.Views">

    <!-- DataContext is the StartupViewModel, supplied by the typed-nav DataTemplate (#15). -->
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <!-- Version 8: Language (Settings › System), near Start at login. -->
        <c:Section Title="{Binding LanguageSectionTitle}">
            <StackPanel Spacing="10">
                <ComboBox MinWidth="240" HorizontalAlignment="Left"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberBinding="{Binding NativeName}" />
                <TextBlock Text="{Binding LanguageNote}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
            </StackPanel>
        </c:Section>

        <!-- Intuos4 status light: dim, bright while the pen touches (feature report 0x20). -->
        <c:Section Title="{Binding StatusLedSectionTitle}">
            <c:ToggleSetting x:Name="StatusLedToggle" Label="{Binding StatusLedLabel}"
                             Description="{Binding StatusLedDescription}"
                             IsChecked="{Binding StatusLedBrightOnTouch}" />
        </c:Section>

        <!-- Settings backup: export / import (preview first) and automatic backups. -->
        <v:BackupView DataContext="{Binding Backup}" IsVisible="{Binding Backup, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Startup (#360): launch with Windows so hotkeys are ready at login. -->
        <c:Section Title="Auto-run" IsVisible="{Binding StartupSupported}">
            <StackPanel Spacing="10">
                <c:ToggleSetting Label="Start Tablet App for Mac when Windows starts"
                                 Description="Launches minimized to the tray at sign-in, so hotkeys are ready without opening it yourself."
                                 IsChecked="{Binding StartWithWindows}" />
                <TextBlock Text="{Binding RegistryMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           IsVisible="{Binding HasRegistryMessage}" />
            </StackPanel>
        </c:Section>

        <!-- Build P: macOS start at login (SMAppService.mainAppService). Re-checked whenever this page opens. -->
        <c:Section Title="{Binding StartAtLoginSectionTitle}" IsVisible="{Binding LoginItemSupported}">
            <StackPanel Spacing="10">
                <c:ToggleSetting x:Name="StartAtLoginToggle" Label="{Binding StartAtLoginToggleLabel}"
                                 Description="{Binding StartAtLoginDescription}"
                                 IsChecked="{Binding StartAtLogin}" />
                <TextBlock Text="{Binding LoginMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" IsVisible="{Binding HasLoginMessage}" />
                <Button Content="{Binding OpenLoginItemsLabel}" HorizontalAlignment="Left" Command="{Binding OpenLoginItemsCommand}"
                        ToolTip.Tip="{Binding OpenLoginItemsTip}" />
            </StackPanel>
        </c:Section>

        <!-- Build Q: macOS without a working SMAppService: the choice is shown as unavailable. -->
        <c:Section Title="{Binding StartAtLoginSectionTitle}" IsVisible="{Binding LoginItemUnavailableOnMac}">
            <TextBlock Text="{Binding LoginUnavailableMessage}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </c:Section>

        <!-- Fallback when no run-at-startup mechanism is available. -->
        <c:Section>
            <c:Section.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!StartupSupported" />
                    <Binding Path="!LoginItemSupported" />
                    <Binding Path="!LoginItemUnavailableOnMac" />
                </MultiBinding>
            </c:Section.IsVisible>
            <TextBlock Text="Run at startup isn't available on this platform."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </c:Section>
    </StackPanel>
</UserControl>
