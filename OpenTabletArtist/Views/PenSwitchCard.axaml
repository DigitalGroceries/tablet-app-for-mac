<UserControl x:Class="OpenTabletArtist.Views.PenSwitchCard" x:Name="CardRoot"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenTabletArtist.Controls"
             xmlns:v="using:OpenTabletArtist.Views"
             xmlns:conv="using:OpenTabletArtist.Converters">

    <!-- One pen switch (tip / eraser / button N). DataContext is a PenSwitchRowViewModel.
         Build R5 (the user's mock-ups): larger, letter-spaced headings, larger Change… / Default buttons of one
         fixed size (104 × 34) so every row lines up on the same grid, and a larger status line ("Default setting" / "Modified to X" since R7: it reports the binding, not a hardware check).
         Add Classes="hero" for the big ERASER / PEN TIP headings on the Pen page. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.penHeading">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- V29 (Digital Groceries 16 Nov 16:11, missed until 19 Nov): the action is shown in FULL ('Radial menu: Undo, Redo, Copy…',
             'Default (eraser)'): the box wraps onto more lines instead of cutting the text. It keeps one width (146, the card's
             240 minus the 84 heading and 10 gap) so every card lines up and the Radial Menu Settings picture keeps its real size. -->
        <Style Selector="TextBlock.penHeading.shout">
            <Setter Property="FontWeight" Value="Black" />
        </Style>
        <Style Selector="TextBlock.penValue">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <!-- V31 (task list L7.19, Digital Groceries' mockup of 25 Nov 2026): a square-cornered frame cut into the page - the page's own
             grey, a dark shade inside its edges, a thin light line round it (LightnessService.SunkenResources) - and on the two
             button cards a larger box of one size (146 x 67, measured on the mockup) with wider, heavier lettering: the
             words are drawn 1.2 times as wide as they are high. -->
        <Style Selector="Border.penValueBox">
            <Setter Property="Background" Value="{DynamicResource InsetBoxBrush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BoxShadow" Value="{DynamicResource InsetBoxShadow}" />
            <Setter Property="Width" Value="146" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Border.penValueBox.wide">
            <Setter Property="MinHeight" Value="67" />
            <Setter Property="Padding" Value="4,6" />
        </Style>
        <Style Selector="Border.penValueBox.wide LayoutTransformControl">
            <Setter Property="LayoutTransform" Value="scale(1.2,1)" />
        </Style>
        <Style Selector="Border.penValueBox TextBlock.penValue.wide">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <!-- the box's 138 of room, divided by the 1.2: a set width, so the lines break the same way when measured and when drawn -->
            <Setter Property="Width" Value="115" />
        </Style>
        <Style Selector="Button.penAction">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.working">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="PathIcon.working">
            <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="v|PenSwitchCard.hero TextBlock.penHeading">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="LetterSpacing" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="v|PenSwitchCard.hero TextBlock.working">
            <Setter Property="FontSize" Value="21" />
        </Style>
        <Style Selector="v|PenSwitchCard.hero PathIcon.working">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
        </Style>
    </UserControl.Styles>

    <!-- v27 (Digital Groceries 16:39): 240 wide (was 300). Every row is at most 220 (heading 84 + 10 + value box 126; Change… 104 + 12 + Default 104),
         so nothing on screen moves; the 60 points freed on the right let the Radial Menu Settings picture sit at its real size where the
         open menu was in Digital Groceries' screenshot. "Modified to X" wraps a little earlier. -->
    <!-- V29 (Digital Groceries 16 Nov 16:11): the card sits right next to the pen drawing (left-aligned). -->
    <StackPanel Spacing="12" Width="240" HorizontalAlignment="Left">
        <!-- Heading, with the current action on the same line for side buttons ("BUTTON 2:  Right click"). -->
        <!-- R14 (the user's mock-up): the button's current action in a dark value box. The heading column has a fixed
             width so every card's box starts at the same x; the boxes are one width (the two buttons below). -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="penHeading" Text="{Binding SectionLabel}" MinWidth="84"
                       IsVisible="{Binding !#CardRoot.Shout}" />
            <!-- V29 #180 (Digital Groceries' mockup 21 Nov: "BUTTON 2", "BUTTON 1"; ~12:14 "These are all caps because they need to catch the
                 user attention first"): the Pen page's cards show the heading in capitals, heavier. -->
            <TextBlock x:Name="ShoutHeading" Classes="penHeading shout" MinWidth="84"
                       Text="{Binding SectionLabel, Converter={x:Static conv:UpperCaseConverter.Instance}}"
                       IsVisible="{Binding #CardRoot.Shout}" />
            <Border x:Name="ValueBox" Classes="penValueBox" Classes.wide="{Binding #CardRoot.Shout}" IsVisible="{Binding ShowChooseAction}">
                <LayoutTransformControl x:Name="ValueStretch" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ValueText" Classes="penValue" Classes.wide="{Binding #CardRoot.Shout}" Text="{Binding CurrentPlainLabel}" HorizontalAlignment="Center" />
                </LayoutTransformControl>
            </Border>
            <!-- V29 #177 (Digital Groceries 20 Nov ~20:18: "It would read better if the text is on one line and not two ... 'Pen Tip Default
                 Setting'"): the default status sits on the heading's line, as plain text (no tick, Digital Groceries ~20:08). -->
            <TextBlock x:Name="LblDefaultSetting" Classes="working" Text="Default setting" IsVisible="{Binding IsRecommended}"
                       AutomationProperties.Name="Default setting"
                       ToolTip.Tip="This input uses its default action. This is not a hardware test." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowChooseAction}">
            <Button x:Name="BtnChange" Classes="penAction" Content="Change…" Command="{Binding ChooseActionCommand}"
                    ToolTip.Tip="Choose what this button or the eraser does" />
            <Button x:Name="BtnDefault" Classes="penAction" Content="Default" Command="{Binding SetAutoCommand}"
                    IsVisible="{Binding ShowUseAdaptive}"
                    ToolTip.Tip="Put this button back to its normal behaviour" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding IsNotRecommended}">
            <TextBlock Classes="working" Text="{Binding ModifiedLabel}"
                       TextWrapping="Wrap" AutomationProperties.Name="{Binding ModifiedLabel}" />
            <Button x:Name="BtnFix" Classes="penAction" Content="Fix" Command="{Binding SetAutoCommand}"
                    IsVisible="{Binding ShowUseAdaptive}" HorizontalAlignment="Left"
                    ToolTip.Tip="Reset this input to its default action" />
        </StackPanel>
    </StackPanel>
</UserControl>
