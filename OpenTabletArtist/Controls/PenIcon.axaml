<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenTabletArtist.Controls.PenIcon">
  <!-- R18: the pen from the app icon (Assets/appicon.svg, icon-v2): same shape, shading, highlight, nib and
       angle. Generated by tools/make_pen_icon.py into a 34 x 26 box like the other Tool tiles; a thin
       outline (PenIconOutlineBrush) keeps it readable on the dark unselected tile. White capped at #E4E4E4. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="PenIconOutlineBrush" Color="#8C8C8C" />
  </UserControl.Resources>
  <Viewbox Width="34" Height="26"><Canvas Width="34" Height="26">
    <Path Data="M 25.094,1.994 L 25.616,1.381 C 25.905,1.041 26.417,1.000 26.758,1.290 C 27.099,1.580 27.140,2.092 26.851,2.432 L 26.310,3.068 L 26.578,3.305 L 13.411,20.014 L 12.394,21.797 L 7.870,24.327 L 7.357,23.893 L 9.012,18.934 L 10.485,17.813 L 24.820,1.752 L 25.094,1.994 Z" Stroke="{DynamicResource PenIconOutlineBrush}" StrokeThickness="0.45" StrokeJoin="Round"><Path.Fill><LinearGradientBrush StartPoint="15.686,17.139" EndPoint="12.719,14.641" SpreadMethod="Pad"><GradientStop Offset="0" Color="#a8a8a8"/><GradientStop Offset="1" Color="#3a3a3a"/></LinearGradientBrush></Path.Fill></Path>
    <Path Data="M 26.640,1.206 L 25.863,2.415 L 11.332,19.373 L 10.566,20.560 L 7.531,24.040 L 7.357,23.893 L 9.012,18.934 L 10.485,17.813 L 24.820,1.752 L 25.094,1.994 L 25.616,1.381 C 25.873,1.078 26.307,1.013 26.640,1.206 Z"><Path.Fill><LinearGradientBrush StartPoint="11.400,16.118" EndPoint="13.175,17.599" SpreadMethod="Pad"><GradientStop Offset="0" Color="#707070"/><GradientStop Offset="1" Color="#1e1e1e"/></LinearGradientBrush></Path.Fill></Path>
    <Path Data="M 7.870,24.327 L 6.860,25.000 L 7.357,23.893 Z"><Path.Fill><LinearGradientBrush StartPoint="7.620,24.625" EndPoint="7.107,24.191" SpreadMethod="Pad"><GradientStop Offset="0" Color="#5a5a5a"/><GradientStop Offset="1" Color="#151515"/></LinearGradientBrush></Path.Fill></Path>
    <Path Data="M 8.024,23.944 L 11.712,21.300 L 12.695,19.607 L 26.053,3.168 L 26.253,3.331 L 13.008,19.841 L 12.130,21.546 L 8.024,23.944 Z" Fill="#E4E4E4" />
    <Path Data="M 26.162,2.971 L 25.964,2.816 L 26.506,2.240 C 26.506,2.240 26.709,2.025 26.797,1.721 C 26.865,1.905 26.848,2.103 26.747,2.315 L 26.162,2.971 Z" Fill="#E4E4E4" />
  </Canvas></Viewbox>
</UserControl>
