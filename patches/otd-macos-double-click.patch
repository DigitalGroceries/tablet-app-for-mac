diff --git a/external/OpenTabletDriver/OpenTabletDriver.Plugin/Platform/Pointer/IMouseDoubleClickHandler.cs b/external/OpenTabletDriver/OpenTabletDriver.Plugin/Platform/Pointer/IMouseDoubleClickHandler.cs
