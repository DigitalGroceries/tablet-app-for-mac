diff --git a/OpenTabletDriver.Plugin/Platform/Pointer/HeldButtonRelease.cs b/OpenTabletDriver.Plugin/Platform/Pointer/HeldButtonRelease.cs
new file mode 100644
index 0000000..1e7b92c
--- /dev/null
+++ b/OpenTabletDriver.Plugin/Platform/Pointer/HeldButtonRelease.cs
@@ -0,0 +1,33 @@
+using System;
+
+namespace OpenTabletDriver.Plugin.Platform.Pointer
+{
+    /// <summary>
+    /// Tablet App for Mac (#73): lets go of the buttons a pointer still holds, once, with an honest log line for
+    /// every outcome. Never throws: it runs while a pointer is being dropped, and a failure there must not stop
+    /// the rest of the shutdown (it is logged, not hidden).
+    /// </summary>
+    public static class HeldButtonRelease
+    {
+        /// <returns>True when the pointer held buttons and they were released; false when nothing was held,
+        /// the pointer can't hold buttons, or the release failed (the failure is logged as a warning).</returns>
+        public static bool TryRelease(object? pointer, string group, string reason)
+        {
+            if (pointer is not IHeldButtonReleaser releaser)
+                return false;
+            try
+            {
+                if (!releaser.HasHeldButtons)
+                    return false;
+                releaser.ReleaseHeldButtons();
+                Log.Write(group, $"Released the mouse buttons that were held ({reason})", LogLevel.Info);
+                return true;
+            }
+            catch (Exception e)
+            {
+                Log.Write(group, $"Couldn't release the held mouse buttons ({reason}): {e.Message}", LogLevel.Warning);
+                return false;
+            }
+        }
+    }
+}
diff --git a/OpenTabletDriver.Plugin/Platform/Pointer/IHeldButtonReleaser.cs b/OpenTabletDriver.Plugin/Platform/Pointer/IHeldButtonReleaser.cs
new file mode 100644
index 0000000..506e048
--- /dev/null
+++ b/OpenTabletDriver.Plugin/Platform/Pointer/IHeldButtonReleaser.cs
@@ -0,0 +1,17 @@
+namespace OpenTabletDriver.Plugin.Platform.Pointer
+{
+    /// <summary>
+    /// Tablet App for Mac (#73): a pointer whose buttons stay down in the operating system until someone posts
+    /// the matching "up". When the pointer is dropped (tablet unplugged, settings change, driver stopping) any
+    /// button it still holds must be let go first, or the system keeps a button pressed that nobody will ever
+    /// release.
+    /// </summary>
+    public interface IHeldButtonReleaser
+    {
+        /// <summary>True when the pointer has posted a button down that it hasn't let go yet.</summary>
+        bool HasHeldButtons { get; }
+
+        /// <summary>Posts an up for every button this pointer holds.</summary>
+        void ReleaseHeldButtons();
+    }
+}
