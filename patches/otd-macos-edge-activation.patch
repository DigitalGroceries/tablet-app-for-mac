diff --git a/external/OpenTabletDriver/OpenTabletDriver.Desktop/Interop/Input/MacOSAppActivator.cs b/external/OpenTabletDriver/OpenTabletDriver.Desktop/Interop/Input/MacOSAppActivator.cs
