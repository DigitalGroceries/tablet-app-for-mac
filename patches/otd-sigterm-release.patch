+            // Tablet App for Mac (#73, v27): handle SIGTERM ourselves. The app stops the driver politely with SIGTERM so the
+            // driver can let go of a held mouse button, but .NET does NOT run the Unloading handler below on SIGTERM:
+            // a test process with exactly this shape was simply terminated (exit 143) and its clean-up never ran. With
+            // this registration the clean-up runs (exit 0). Cancel = true: the main thread finishes on its own, after
+            // ReleaseAllHeldButtons, instead of the process dying the moment this handler returns.
+            PosixSignalRegistration? sigTerm = null;
+            if (!RuntimeInformation.IsOSPlatform(OSPlatform.Windows))
+            {
+                sigTerm = PosixSignalRegistration.Create(PosixSignal.SIGTERM, ctx =>
+                {
+                    ctx.Cancel = true;
+                    Log.Write("signal", "SIGTERM: stopping the driver and letting go of held mouse buttons");
+                    CloseDaemon();
+                });
+            }
